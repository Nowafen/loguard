# Loguard configuration example
# Copy this to /etc/loguard/config.toml and fill in real values, OR just
# run `sudo loguard edit` after installation -- it writes this file for you.

bot_token = "123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
chat_id   = "987654321"
hostname  = "my-server"
os_info   = "Ubuntu 24.04 LTS (x86_64)"

# Heartbeat: send an "I'm alive" message every N minutes (0 = disabled)
heartbeat_minutes = 15

# Auto-heal: if PAM rules get deleted/edited out, re-apply them automatically
self_heal_pam = true

# --- Session Monitor v2 ---

# How often (seconds) the daemon scans `ps` for new processes per active session
process_poll_seconds = 5

# Look up country/city/ISP for remote login IPs via ip-api.com (free, no key, cached)
enable_geoip = true

# A session's risk score crossing this value fires an immediate HIGH RISK alert
high_risk_threshold = 100

# --- Anti-tamper hardening (v0.2.0) ---

# chattr +i on binaries + PAM files after `enable` -- even root must clear
# this flag before it can overwrite/delete/rename those files.
enable_immutable = true

# External dead-man's-switch: get a free check at https://healthchecks.io,
# paste its ping URL here. If pings stop, THAT service alerts you -- not
# this machine -- which is what makes it survive a full compromise of this
# exact host. Leave empty to disable.
healthcheck_url = ""
deadman_interval_seconds = 120

# admin_passphrase_hash / admin_passphrase_salt are written automatically by
# `sudo loguard set-password` -- never set these by hand.
