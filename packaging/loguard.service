[Unit]
Description=Loguard Real-Time Login Alert Daemon
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/Nowafen/Loguard

[Service]
Type=simple
ExecStart=/opt/loguard/bin/loguard daemon
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=loguardd
User=root
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/loguard /var/lib/loguard /var/log/loguard /run/loguard
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
